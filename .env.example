APP_NAME=DefectMind
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api

# Database (Phase 2)
# Note: URL-encode special characters in password (@ → %40)
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@127.0.0.1:5432/bugtracker_db

# JWT (Phase 3)
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OTP (Phase 3)
OTP_EXPIRE_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# SMTP / Email (Phase 3)
# Use a Gmail App Password (not your account password)
# Gmail → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=DefectMind
SMTP_USE_TLS=true
