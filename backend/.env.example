# Application
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api

# Use either DATABASE_URL or the individual DB_* values below.
DATABASE_URL=postgresql+psycopg://username:password@hostname:5432/bugtracker_db
# DB_DRIVER=postgresql+psycopg
# DB_USER=postgres
# DB_PASSWORD=change-me
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=bugtracker_db

# Generate a unique random value of at least 32 characters.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated browser origins.
CORS_ORIGINS=https://your-frontend.example.com

# Optional email delivery settings.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=BugTracker
SMTP_USE_TLS=true